		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@eslint/js": "^10.0.1",
		"@rolldown/plugin-babel": "^0.2.3",
